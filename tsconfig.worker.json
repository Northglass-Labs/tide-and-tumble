{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    // Runtime and binding types come from worker-configuration.d.ts
    // (`npm run types`); the plugin types add `cloudflare:test` for tests.
    "types": ["@cloudflare/vitest-plugin/types", "vite/client"]
  },
  "include": ["src/worker", "test/worker", "worker-configuration.d.ts"]
}
