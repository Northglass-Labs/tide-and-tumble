{
  "name": "tide-and-tumble",
  "version": "0.1.0",
  "private": true,
  "description": "A whimsical, live tide chart for US beaches — a Northglass Product.",
  "homepage": "https://tideandtumble.app",
  "author": "Northglass LLC <hello@northglass.io>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Northglass-Labs/tide-and-tumble.git"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "prepare": "npm run types",
    "types": "wrangler types --strict-vars false --config wrangler.jsonc",
    "dev": "next dev",
    "typecheck": "npm run types && next typegen && tsc --noEmit -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "next build",
    "check": "node scripts/check-build.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check",
    "preview": "npm run build && wrangler dev --config wrangler.jsonc --port 4183 --var APP_ORIGIN:http://localhost:4183",
    "audit": "node scripts/audit.mjs",
    "health": "node scripts/health.mjs",
    "promote": "node scripts/promote.mjs",
    "rollback": "node scripts/rollback.mjs"
  },
  "dependencies": {
    "hono": "^4.13.22",
    "leaflet": "^1.9.4",
    "lottie-react": "^3.1.2",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2",
    "wrangler": "4.168.0"
  },
  "overrides": {
    "postcss": "^8.4.32"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  }
}
